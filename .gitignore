# ==============================================================================
# Credit Ledger — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Bytecode & Python Runtime
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging & Distribution
# NOTE: anchored to repo root (leading /) so these generic names can never
# shadow source directories such as client/src/lib/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
/venv/
.venv/
/env/
/ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Next.js Frontend (client/)
# ------------------------------------------------------------------------------
client/node_modules/
client/.next/
client/out/
client/build/
client/.vercel/
client/*.tsbuildinfo
client/next-env.d.ts

# Node (root-level safety net; client/ has its own rules above)
node_modules/
.next/
*.tsbuildinfo

# Node / Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variable secrets
.env
.env*.local
!.env.example

# ------------------------------------------------------------------------------
# 4. Large Datasets & Storage
# ------------------------------------------------------------------------------
# Raw CSVs & binary parquet data tables (several GBs)
data/*.csv
data/*.parquet
data/*.zip
data/*.tar.gz
data/*.gz

# Retain generated markdown data-quality and preprocessing summaries
!data/data_quality_report.md
!data/preprocessing_summary.txt

# ------------------------------------------------------------------------------
# 5. Heavy Trained Model Weights & Binaries
# ------------------------------------------------------------------------------
# Binary model weights (use Git LFS or external artifact store for large checkpoints)
models/*.joblib
models/*.pt
models/*.pth
models/*.pkl
models/*.onnx
models/*.bin

# Retain model configs, tuning results, and evaluation reports
!models/best_hyperparameters.json
!models/evaluation_results.json
!models/chunk_metrics.json
!models/tuning_results.md
!models/evaluation_results.md
!models/preprocessor_*.joblib

# Generated API cache — do NOT commit (auto-regenerates on server start)
models/baseline_features.json

# OOF prediction cache (large numpy arrays, regenerated by train_models.py)
models/oof_cache/

# Retain evaluation suite scripts & visualization figures
!models/evaluation/
!models/evaluation/*.py
!models/evaluation/*.png
!models/evaluation/*.md
!models/figures/
!models/figures/*.png

# ------------------------------------------------------------------------------
# 6. Logging, Testing & Cache Artifacts
# ------------------------------------------------------------------------------
*.log
models/*.log
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 7. Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 8. Editor & Operating System Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.freebuff/

# ------------------------------------------------------------------------------
# 9. Report Figures (generated by reports/generate_report_figures.py)
# ------------------------------------------------------------------------------
# Explicitly track generated report figures — output artifacts for the written report
!reports/figures/
!reports/figures/*.png
